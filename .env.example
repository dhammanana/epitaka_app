# Copy this file to `.env` and fill in real values.
# Supabase → Account → Access Tokens to create a personal access token.

SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key
SUPABASE_OAUTH_REDIRECT_URI=epitaka://login-callback/

# Google OAuth provider (Supabase Auth → Providers → Google).
# Client secret comes from Google Cloud Console → Credentials → OAuth client.
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
